---
import anima from '../assets/anima.mp4';
import { heroe as heroeLocal } from '../data/home';

interface Props {
	heroe?: typeof heroeLocal;
}

const { heroe = heroeLocal } = Astro.props;

/* Vitrina de cartelera: el video abre 7 segundos, luego la obra 30,
   el último fotograma 15 y otra vez la obra 30. A partir de ahí se
   alternan fotograma y obra. Sin JS, o con menos movimiento, se ve
   directo el programa. */
const { funcion } = heroe;
---

<aside
	class="cartelera"
	aria-labelledby="cartelera-obra"
	data-cartelera
	data-luz="encendida"
	data-escena="anima"
>
	<span class="lampara" aria-hidden="true">
		<span class="lampara__pantalla">
			<span class="lampara__foco"></span>
		</span>
		<span class="lampara__brazo"></span>
	</span>

	<div class="cartelera__caja">
		<div class="cartelera__luz" aria-hidden="true"></div>
		<div class="cartelera__haz" aria-hidden="true"></div>
		<div class="cartelera__filete" aria-hidden="true"></div>

		<div class="cartelera__anima" aria-hidden="true">
			<video
				class="anima"
				src={anima}
				muted
				playsinline
				preload="auto"
				tabindex="-1"
			></video>
		</div>

		<div class="cartelera__escenas">
			<div class="escena escena--programa">
				<p class="cartelera__rotulo">{funcion.rotulo}</p>
				<div class="cartelera__regla" aria-hidden="true"></div>

				<h2 class="cartelera__obra" id="cartelera-obra">{funcion.obra}</h2>
				<p class="cartelera__autor">{funcion.autor}</p>

				<div class="ornamento" aria-hidden="true">
					<span class="ornamento__linea ornamento__linea--izq"></span>
					<span class="rombo"></span>
					<span class="ornamento__linea ornamento__linea--der"></span>
				</div>

				{
					funcion.foto && (
						<figure class="cartelera__foto">
							<img
								src={funcion.foto.src}
								alt={funcion.foto.alt}
								width={funcion.foto.ancho}
								height={funcion.foto.alto}
								style={funcion.foto.foco ? `object-position: ${funcion.foto.foco}` : undefined}
								loading="eager"
							/>
						</figure>
					)
				}

				<a class="cartelera__cta" href={funcion.ctaHref}>{funcion.cta}</a>
			</div>
		</div>

		<div class="cartelera__vidrio" aria-hidden="true"></div>
		<div class="cartelera__apagon" aria-hidden="true"></div>
	</div>
</aside>

<style>
	.cartelera {
		justify-self: end;
		width: min(100%, 25rem);
		animation: subir 1.1s var(--ease) 0.28s both;
	}

	/* ---------- Lampara de vitrina ---------- */

	.lampara {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
	}

	.lampara__pantalla {
		position: relative;
		width: clamp(3.25rem, 3.75vw, 4.5rem);
		height: 0.9rem;
		border-radius: 1.2rem 1.2rem 0.1rem 0.1rem;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--hueso) 16%, var(--negro)),
			var(--negro)
		);
		box-shadow: inset 0 1px 0 color-mix(in srgb, var(--hueso) 22%, transparent);
	}

	.lampara__foco {
		position: absolute;
		inset: auto 24% -0.16rem;
		height: 0.3rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--hueso) 82%, var(--rojo));
		filter: blur(1.5px);
	}

	.lampara__brazo {
		width: 1px;
		height: 0.7rem;
		background: linear-gradient(to bottom, var(--linea), transparent);
	}

	/* ---------- Vitrina ---------- */

	/* Remate curvo arriba: la vitrina repite la boca del escenario */
	.cartelera__caja {
		--arco: 9%;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: clamp(1.9rem, 4vw, 2.6rem) clamp(1.6rem, 3.4vw, 2.3rem)
			clamp(1.6rem, 3.4vw, 2.2rem);
		border: 1px solid var(--linea);
		border-radius: 44% 44% 0.3rem 0.3rem / var(--arco) var(--arco) 0 0;
		background: linear-gradient(to bottom, var(--negro-carta), var(--negro) 85%);
		box-shadow:
			0 1.75rem 4rem rgba(0, 0, 0, 0.6),
			0 0.4rem 1rem rgba(0, 0, 0, 0.35);
	}

	.cartelera__luz {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(
				ellipse 85% 45% at 50% 0%,
				color-mix(in srgb, var(--hueso) 14%, transparent),
				transparent 72%
			),
			radial-gradient(
				ellipse 70% 40% at 50% 100%,
				color-mix(in srgb, var(--rojo) 26%, transparent),
				transparent 75%
			);
	}

	/* Haz que baja de la lampara sobre el cartel */
	.cartelera__haz {
		position: absolute;
		inset: 0 auto auto 50%;
		z-index: -1;
		width: 150%;
		height: 100%;
		translate: -50% 0;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--hueso) 11%, transparent),
			transparent 68%
		);
		clip-path: polygon(45% 0, 55% 0, 100% 100%, 0 100%);
		filter: blur(10px);
	}

	.cartelera__filete {
		position: absolute;
		z-index: 2;
		inset: 0.55rem;
		border: 1px solid var(--linea-suave);
		border-radius: 44% 44% 0.2rem 0.2rem / 9% 9% 0 0;
		pointer-events: none;
	}

	/* Reflejo del cristal de la vitrina */
	.cartelera__vidrio {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background: linear-gradient(
			112deg,
			transparent 36%,
			color-mix(in srgb, var(--hueso) 5%, transparent) 44%,
			transparent 53%
		);
	}

	/* Velo del apagon: se levanta y baja con la luz */
	.cartelera__apagon {
		position: absolute;
		inset: 0;
		z-index: 5;
		pointer-events: none;
		background: var(--negro);
	}

	/* ---------- Cuadros ---------- */

	.cartelera__escenas {
		position: relative;
		z-index: 1;
		display: grid;
		min-height: clamp(21rem, 42vh, 26rem);
		text-align: center;
	}

	.escena {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.35s var(--ease),
			visibility 0.35s var(--ease);
	}

	.cartelera[data-escena='programa'] .escena--programa,
	.cartelera[data-escena='anima'] .cartelera__anima {
		opacity: 1;
		visibility: visible;
	}

	/* El video llena toda la vitrina, arco incluido.
	   El cuadro se recorta (no se estira) y el 10% inferior queda
	   fuera para tapar la marca de agua. */
	.cartelera__anima {
		position: absolute;
		z-index: 0;
		inset: 0;
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 0.35s var(--ease),
			visibility 0.35s var(--ease);
	}

	.anima {
		display: block;
		width: 100%;
		height: calc(100% / 0.9);
		object-fit: cover;
		object-position: center top;
	}

	@media (prefers-reduced-motion: reduce) {
		.cartelera[data-escena='anima'] .cartelera__anima {
			opacity: 0;
			visibility: hidden;
		}

		.cartelera[data-escena='anima'] .escena--programa {
			opacity: 1;
			visibility: visible;
		}
	}

	/* ---------- Cuadro: programa ---------- */

	.cartelera__rotulo {
		margin: 0;
		font-family: var(--fuente-rotulo);
		font-size: 0.72rem;
		letter-spacing: 0.3em;
		text-indent: 0.3em;
		color: var(--rojo-luz);
	}

	/* Filete doble: recurso de imprenta clásica */
	.cartelera__regla {
		width: 100%;
		height: 3px;
		margin-top: 0.9rem;
		border-top: 1px solid var(--linea);
		border-bottom: 1px solid var(--linea-suave);
	}

	.cartelera__obra {
		margin: clamp(1.4rem, 3vh, 1.9rem) 0 0;
		font-family: var(--fuente-cuerpo);
		font-weight: 400;
		font-size: clamp(1.5rem, 2.6vw, 1.95rem);
		line-height: 1.18;
		letter-spacing: -0.01em;
	}

	.cartelera__autor {
		margin: 0.85rem 0 0;
		font-size: 0.88rem;
		color: var(--hueso-medio);
	}

	.cartelera__foto {
		width: 100%;
		margin: 0;
	}

	.cartelera__foto img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border: 1px solid var(--linea-suave);
	}

	.cartelera__cta {
		margin-top: clamp(1.6rem, 3.5vh, 2.1rem);
		padding: 0.85rem 1.9rem;
		font-family: var(--fuente-rotulo);
		font-size: 0.74rem;
		letter-spacing: 0.2em;
		text-indent: 0.2em;
		text-decoration: none;
		color: var(--hueso);
		background: var(--rojo);
		transition: background 0.35s var(--ease);
	}

	.cartelera__cta:hover {
		background: var(--rojo-luz);
	}

	/* ---------- Ornamento ---------- */

	.ornamento {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-block: clamp(1.4rem, 3vh, 1.9rem);
	}

	.ornamento__linea {
		height: 1px;
		width: clamp(2rem, 6vw, 3.25rem);
	}

	.ornamento__linea--izq {
		background: linear-gradient(to right, transparent, var(--linea));
	}

	.ornamento__linea--der {
		background: linear-gradient(to left, transparent, var(--linea));
	}

	/* ---------- Encendido y apagado ---------- */

	.cartelera__luz,
	.cartelera__haz,
	.lampara__foco {
		animation: encender 1s var(--ease) both;
	}

	.cartelera__apagon {
		animation: despejar 1s var(--ease) both;
	}

	.cartelera[data-luz='apagada'] .cartelera__luz,
	.cartelera[data-luz='apagada'] .cartelera__haz,
	.cartelera[data-luz='apagada'] .lampara__foco {
		animation: apagar 0.45s ease-in both;
	}

	.cartelera[data-luz='apagada'] .cartelera__apagon {
		animation: cubrir 0.45s ease-in both;
	}

	/* El titubeo del filamento al arrancar */
	@keyframes encender {
		0% {
			opacity: 0;
		}
		9% {
			opacity: 0.75;
		}
		15% {
			opacity: 0.1;
		}
		24% {
			opacity: 0.95;
		}
		32% {
			opacity: 0.3;
		}
		46% {
			opacity: 1;
		}
		58% {
			opacity: 0.85;
		}
		100% {
			opacity: 1;
		}
	}

	@keyframes despejar {
		0% {
			opacity: 1;
		}
		9% {
			opacity: 0.3;
		}
		15% {
			opacity: 0.92;
		}
		24% {
			opacity: 0.08;
		}
		32% {
			opacity: 0.66;
		}
		46% {
			opacity: 0;
		}
		58% {
			opacity: 0.14;
		}
		100% {
			opacity: 0;
		}
	}

	/* Al apagarse queda un rescoldo antes de irse del todo */
	@keyframes apagar {
		0% {
			opacity: 1;
		}
		28% {
			opacity: 0.42;
		}
		44% {
			opacity: 0.5;
		}
		100% {
			opacity: 0;
		}
	}

	@keyframes cubrir {
		0% {
			opacity: 0;
		}
		28% {
			opacity: 0.62;
		}
		44% {
			opacity: 0.55;
		}
		100% {
			opacity: 0.94;
		}
	}

	@keyframes subir {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (max-width: 62rem) {
		.cartelera {
			justify-self: center;
			width: min(100%, 22rem);
		}

		.cartelera__escenas {
			min-height: 21rem;
		}
	}
</style>

<noscript>
	<style>
		.cartelera[data-escena='anima'] .cartelera__anima {
			opacity: 0;
			visibility: hidden;
		}

		.cartelera[data-escena='anima'] .escena--programa {
			opacity: 1;
			visibility: visible;
		}
	</style>
</noscript>

<script>
	const cartelera = document.querySelector<HTMLElement>('[data-cartelera]');
	const video = cartelera?.querySelector<HTMLVideoElement>('.anima');

	/* El video corre una sola vez. Después solo vuelve su último fotograma. */
	if (cartelera && video) {
		const VIDEO = 7000;
		const OBRA = 30000;
		const FOTOGRAMA = 15000;
		const A_OSCURAS = 950;
		const CAMBIO = 480;

		const dormir = (ms: number) =>
			new Promise<void>((listo) => window.setTimeout(listo, ms));

		const congelar = () => {
			video.pause();
			if (video.ended || !Number.isFinite(video.duration)) return;
			video.currentTime = Math.max(0, video.duration - 0.05);
		};

		const cambiar = async (escena: 'anima' | 'programa') => {
			cartelera.dataset.luz = 'apagada';
			await dormir(CAMBIO);
			cartelera.dataset.escena = escena;
			await dormir(A_OSCURAS - CAMBIO);
			cartelera.dataset.luz = 'encendida';
		};

		const ciclo = async () => {
			const arranque = performance.now();
			try {
				await video.play();
			} catch {
				video.pause();
				cartelera.dataset.escena = 'programa';
				return;
			}

			await dormir(Math.max(0, VIDEO - (performance.now() - arranque)));
			congelar();
			await cambiar('programa');

			while (true) {
				await dormir(OBRA);
				await cambiar('anima');
				await dormir(FOTOGRAMA);
				await cambiar('programa');
			}
		};

		const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
		if (sinMovimiento.matches) {
			video.pause();
			cartelera.dataset.escena = 'programa';
		} else {
			void ciclo();
		}
	}
</script>
