---
import { respaldos as respaldosLocal } from '../data/home';

interface Props {
	respaldos?: {
		titular: string;
		logos: { marca: string; nombre: string; src?: string }[];
	};
}

const { respaldos = respaldosLocal } = Astro.props;
const { titular, logos } = respaldos;
---

<section class="respaldos" aria-labelledby="respaldos-titulo">
	<div class="contenedor">
		<div class="respaldos__cabecera revelar">
			<h2 class="respaldos__titulo" id="respaldos-titulo">{titular}</h2>
		</div>

		<ul class="respaldos__rejilla revelar">
			{
				logos.map(({ marca, nombre, src }) => (
					<li class="logo">
						{src ? (
							<img class="logo__img" src={src} alt={nombre} width="320" height="160" loading="lazy" />
						) : (
							<span class="logo__marca" aria-hidden="true">{marca}</span>
						)}
						{src ? null : <span class="sr-only">{nombre}</span>}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.respaldos {
		padding-block: clamp(3.5rem, 4.6vw, 5.5rem);
		border-top: 1px solid var(--linea-suave);
		background: var(--negro);
	}

	.respaldos__cabecera {
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.respaldos__titulo {
		font-family: var(--fuente-rotulo);
		font-size: clamp(2.1rem, 3.2vw + 1rem, 4.5rem);
		font-weight: 400;
		letter-spacing: 0.04em;
		margin: 0;
	}

	.respaldos__rejilla {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		column-gap: clamp(0.75rem, 2vw, 1.4rem);
		row-gap: clamp(0.95rem, 2.2vw, 1.5rem);
		align-items: center;
		width: min(82%, 56rem);
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.logo {
		display: grid;
		place-items: center;
		color: var(--hueso-tenue);
	}

	.logo:hover {
		color: var(--hueso);
	}

	.logo:hover .logo__img {
		opacity: 1;
	}

	.logo__marca {
		font-family: var(--fuente-titular);
		font-size: clamp(0.85rem, 1.8vw, 1.4rem);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-align: center;
	}

	.logo__img {
		display: block;
		width: auto;
		height: auto;
		max-width: 88%;
		max-height: clamp(6.25rem, 7.9vw, 9.5rem);
		object-fit: contain;
		background: none;
		opacity: 0.92;
		transition: opacity 0.3s var(--ease);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
