---
import { respaldos as respaldosLocal } from '../data/home';

interface Props {
	respaldos?: {
		titular: string;
		logos: { marca: string; nombre: string; src?: string }[];
	};
}

const { respaldos = respaldosLocal } = Astro.props;
const { titular, logos } = respaldos;
---

<section class="respaldos" aria-labelledby="respaldos-titulo">
	<div class="contenedor">
		<div class="respaldos__cabecera revelar">
			<h2 class="respaldos__titulo" id="respaldos-titulo">{titular}</h2>
		</div>

		<ul class="respaldos__rejilla revelar">
			{
				logos.map(({ marca, nombre, src }) => (
					<li class="logo">
						{src ? (
							<img class="logo__img" src={src} alt={nombre} width="320" height="160" loading="lazy" />
						) : (
							<span class="logo__marca" aria-hidden="true">{marca}</span>
						)}
						{src ? null : <span class="sr-only">{nombre}</span>}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.respaldos {
		padding-block: clamp(3.5rem, 4.6vw, 5.5rem);
		border-top: 1px solid var(--linea-suave);
		background: var(--negro);
	}

	.respaldos__cabecera {
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.respaldos__titulo {
		font-family: var(--fuente-rotulo);
		font-size: clamp(2.1rem, 3.2vw + 1rem, 4.5rem);
		font-weight: 400;
		letter-spacing: 0.04em;
		margin: 0;
	}

	.respaldos__rejilla {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		column-gap: clamp(1rem, 2.4vw, 2rem);
		row-gap: clamp(1.4rem, 3vw, 2.25rem);
		align-items: center;
		width: 100%;
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.logo {
		display: grid;
		place-items: center;
		color: var(--hueso-tenue);
	}

	.logo:hover {
		color: var(--hueso);
	}

	.logo:hover .logo__img {
		opacity: 1;
	}

	.logo__marca {
		font-family: var(--fuente-titular);
		font-size: clamp(1.15rem, 2.4vw, 1.9rem);
		font-weight: 800;
		letter-spacing: 0.08em;
		text-align: center;
	}

	.logo__img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: clamp(10rem, 16vw, 22rem);
		object-fit: contain;
		background: none;
		opacity: 0.92;
		transition: opacity 0.3s var(--ease);
	}

	@media (max-width: 45rem) {
		.respaldos__rejilla {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
