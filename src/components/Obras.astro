---
import { obrasInicio } from '../data/home';

const { titular, parrafo, cta, fotos } = obrasInicio;
---

<section class="obras seccion" id="obras" data-obras-collage data-activo="false">
	<div class="obras__escena">
		<div class="obras__velo" aria-hidden="true"></div>

		<div
			class="collage revelar"
			aria-roledescription="carrusel"
			aria-label="Fotografías de obras en escena"
		>
			<div class="collage__marco">
				<div class="collage__pista">
					<div class="collage__grupo">
						{
							fotos.map(
								({
									src,
									alt,
									titulo,
									href,
									rotacion = 0,
									escala = 1,
									desfase = '0',
									ancho = '13rem',
								}) => (
									<a
										class="collage__foto"
										href={href}
										aria-label={`Ver detalle de ${titulo}`}
										style={`--rotacion: ${rotacion}deg; --escala: ${escala}; --desfase: ${desfase}; --ancho: ${ancho};`}
									>
										<img
											src={src}
											alt={alt}
											width="480"
											height="640"
											loading="lazy"
											decoding="async"
										/>
										<span class="collage__info">{titulo}</span>
									</a>
								),
							)
						}
					</div>
					<div class="collage__grupo" aria-hidden="true">
						{
							fotos.map(
								({
									src,
									alt,
									titulo,
									href,
									rotacion = 0,
									escala = 1,
									desfase = '0',
									ancho = '13rem',
								}) => (
									<a
										class="collage__foto"
										href={href}
										tabindex="-1"
										style={`--rotacion: ${rotacion}deg; --escala: ${escala}; --desfase: ${desfase}; --ancho: ${ancho};`}
									>
										<img
											src={src}
											alt={alt}
											width="480"
											height="640"
											loading="lazy"
											decoding="async"
										/>
										<span class="collage__info">{titulo}</span>
									</a>
								),
							)
						}
					</div>
				</div>
			</div>
		</div>

		<div class="contenedor obras__texto revelar">
			<h2 class="obras__titular">{titular}</h2>
			<p class="obras__parrafo">{parrafo}</p>
			<a class="obras__cta" href={cta.href}>{cta.etiqueta}</a>
		</div>
	</div>
</section>

<style>
	.obras {
		position: relative;
		overflow: hidden;
		padding-block: 0;
		border-top: 1px solid var(--linea-suave);
		background:
			radial-gradient(
				ellipse 55% 45% at 0% 30%,
				color-mix(in srgb, var(--morado) 22%, transparent),
				transparent 70%
			),
			var(--negro);
	}

	.obras__escena {
		position: relative;
		min-height: clamp(34rem, 60vw, 46rem);
		display: flex;
		align-items: center;
	}

	.obras__velo {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			var(--negro) 0%,
			color-mix(in srgb, var(--negro) 94%, transparent) 30%,
			color-mix(in srgb, var(--negro) 72%, transparent) 43%,
			color-mix(in srgb, var(--negro) 22%, transparent) 58%,
			transparent 68%
		);
	}

	.obras__texto {
		position: relative;
		z-index: 3;
		width: min(100%, 29rem);
		padding-block: clamp(3rem, 7vw, 5rem);
	}

	.obras__titular {
		font-family: var(--fuente-rotulo);
		font-size: clamp(2.1rem, 3.2vw + 1rem, 4.25rem);
		font-weight: 400;
		letter-spacing: 0.04em;
		max-width: 12ch;
		margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
	}

	.obras__parrafo {
		max-width: 34ch;
		margin: 0 0 clamp(1.75rem, 3.5vw, 2.25rem);
		color: var(--hueso-medio);
		font-size: clamp(1.02rem, 1.3vw, 1.15rem);
		line-height: 1.7;
	}

	.obras__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--fuente-rotulo);
		font-size: 0.85rem;
		letter-spacing: 0.2em;
		text-indent: 0.2em;
		text-decoration: none;
		padding: 1.05rem 2.1rem;
		background: var(--rojo);
		color: var(--hueso);
		border: 1px solid transparent;
		transition: background 0.35s var(--ease);
	}

	.obras__cta:hover {
		background: var(--rojo-luz);
	}

	/* ---------- Collage carrusel ---------- */

	.collage {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: flex;
		align-items: center;
	}

	.collage__marco {
		position: absolute;
		inset: 0;
		overflow: hidden;
		contain: layout paint;
		isolation: isolate;
	}

	.collage__pista {
		display: flex;
		width: max-content;
		height: 100%;
		animation: desfilar-obras 52s linear infinite;
		animation-play-state: paused;
		transform: translate3d(-50%, 0, 0);
		backface-visibility: hidden;
	}

	.obras[data-activo='true'] .collage__pista {
		animation-play-state: running;
		will-change: transform;
	}

	.obras[data-activo='true'] .collage:hover .collage__pista {
		animation-play-state: paused;
	}

	.collage__grupo {
		flex: 0 0 100vw;
		width: 100vw;
		height: 100%;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-template-rows: repeat(10, minmax(0, 1fr));
		gap: clamp(0.35rem, 0.7vw, 0.75rem);
		padding: clamp(0.5rem, 1vw, 0.9rem);
	}

	.collage__foto {
		position: relative;
		width: auto;
		height: auto;
		min-width: 0;
		min-height: 0;
		margin: 0;
		overflow: hidden;
		color: var(--hueso);
		text-decoration: none;
		border: 1px solid color-mix(in srgb, var(--hueso) 18%, transparent);
		box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.32);
		transform: rotate(var(--rotacion, 0deg)) scale(var(--escala, 1));
		transition: border-color 0.25s var(--ease);
	}

	.collage__foto:nth-child(1) {
		grid-column: 1 / 5;
		grid-row: 1 / 6;
	}

	.collage__foto:nth-child(2) {
		grid-column: 4 / 7;
		grid-row: 6 / 11;
	}

	.collage__foto:nth-child(3) {
		grid-column: 7 / 10;
		grid-row: 1 / 7;
	}

	.collage__foto:nth-child(4) {
		grid-column: 10 / 13;
		grid-row: 4 / 11;
	}

	.collage__foto:nth-child(5) {
		grid-column: 1 / 4;
		grid-row: 6 / 11;
	}

	.collage__foto:nth-child(6) {
		grid-column: 5 / 8;
		grid-row: 1 / 6;
	}

	.collage__foto:nth-child(7) {
		grid-column: 7 / 11;
		grid-row: 7 / 11;
	}

	.collage__foto:nth-child(8) {
		grid-column: 10 / 13;
		grid-row: 1 / 4;
	}

	.collage__foto img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.collage__info {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		padding: clamp(1rem, 2vw, 1.5rem);
		background: linear-gradient(180deg, transparent 35%, rgba(5, 5, 5, 0.88) 100%);
		font-family: var(--fuente-rotulo);
		font-size: clamp(0.9rem, 1.2vw, 1.15rem);
		letter-spacing: 0.08em;
		line-height: 1.25;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s var(--ease);
	}

	.collage__foto:hover,
	.collage__foto:focus-visible {
		border-color: color-mix(in srgb, var(--rojo-luz) 75%, var(--hueso));
	}

	.collage__foto:hover .collage__info,
	.collage__foto:focus-visible .collage__info {
		opacity: 1;
	}

	.collage__foto:focus-visible {
		outline: 2px solid var(--rojo-luz);
		outline-offset: 3px;
	}

	@keyframes desfilar-obras {
		from {
			transform: translate3d(-50%, 0, 0);
		}
		to {
			transform: translate3d(0, 0, 0);
		}
	}

	@media (max-width: 62rem) {
		.obras__escena {
			min-height: clamp(36rem, 115vw, 44rem);
		}

		.obras__texto {
			width: min(88%, 27rem);
			padding-block: clamp(3rem, 7vw, 4rem);
		}

		.obras__titular {
			max-width: 14ch;
		}

		.collage {
			position: absolute;
			min-height: 0;
		}

		.collage__grupo {
			flex-basis: 150vw;
			width: 150vw;
			min-width: 42rem;
		}

		.obras__velo {
			background: linear-gradient(
				90deg,
				var(--negro) 0%,
				color-mix(in srgb, var(--negro) 94%, transparent) 46%,
				color-mix(in srgb, var(--negro) 46%, transparent) 72%,
				transparent 100%
			);
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.collage__marco {
			overflow-x: auto;
		}

		.collage__pista {
			animation: none;
		}

		.collage__grupo[aria-hidden='true'] {
			display: none;
		}

	}
</style>

<script>
	const seccion = document.querySelector<HTMLElement>('[data-obras-collage]');
	const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (seccion && !sinMovimiento) {
		if ('IntersectionObserver' in window) {
			const observador = new IntersectionObserver(
				([entrada]) => {
					seccion.dataset.activo = String(entrada.isIntersecting);
				},
				{ rootMargin: '15% 0px', threshold: 0.01 },
			);

			observador.observe(seccion);
		} else {
			seccion.dataset.activo = 'true';
		}
	}
</script>
