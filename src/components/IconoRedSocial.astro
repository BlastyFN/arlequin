---
import type { SimpleIcon } from 'simple-icons';

interface Props {
	icon: SimpleIcon;
	size?: number;
}

const { icon, size = 18 } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="currentColor"
	aria-hidden="true"
>
	<path d={icon.path} />
</svg>
