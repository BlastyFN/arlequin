---
/* Capas de ambiente de la sala: telón insinuado, duela en fuga y candilejas.
   Sustituye a la retícula de rombos como fondo del sistema. */
---

<div class="fondo" aria-hidden="true">
	<div class="ambiente"></div>
	<div class="telon"></div>
	<div class="bambalina"></div>
	<div class="piso"></div>
	<div class="vineta"></div>
	<div class="candilejas"></div>
</div>

<style>
	.fondo {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.fondo > * {
		position: absolute;
		inset: 0;
	}

	.ambiente {
		background:
			radial-gradient(
				ellipse 70% 45% at 50% 0%,
				color-mix(in srgb, var(--morado) 45%, transparent),
				transparent 72%
			),
			radial-gradient(
				ellipse 85% 45% at 50% 105%,
				color-mix(in srgb, var(--tinto) 70%, transparent),
				transparent 70%
			);
	}

	/* Telón: dos paños laterales insinuados por el pliegue, no por el color.
	   Se mantienen a baja opacidad para que el negro siga mandando. */
	.telon::before,
	.telon::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: clamp(5rem, 15vw, 14rem);
		opacity: 0.5;
		background-image:
			repeating-linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.75) 0 0.9rem,
				color-mix(in srgb, var(--tinto) 92%, transparent) 0.9rem 2.7rem,
				rgba(0, 0, 0, 0.6) 2.7rem 3.5rem
			),
			linear-gradient(to bottom, var(--tinto), var(--negro) 85%);
	}

	.telon::before {
		left: 0;
		mask-image: linear-gradient(to right, #000, transparent);
	}

	.telon::after {
		right: 0;
		mask-image: linear-gradient(to left, #000, transparent);
	}

	/* Bambalina superior: el paño que cuelga sobre la boca del escenario */
	.bambalina {
		bottom: auto;
		height: clamp(7rem, 20vh, 13rem);
		opacity: 0.34;
		background-image: repeating-linear-gradient(
			90deg,
			rgba(0, 0, 0, 0.8) 0 1rem,
			color-mix(in srgb, var(--tinto) 90%, transparent) 1rem 3rem,
			rgba(0, 0, 0, 0.65) 3rem 3.8rem
		);
		mask-image: radial-gradient(150% 100% at 50% 0%, #000 25%, transparent 78%);
	}

	/* Duela del escenario: líneas en fuga hacia el fondo */
	.piso {
		top: auto;
		height: 50vh;
		background-image: repeating-linear-gradient(
			90deg,
			transparent 0 5.5rem,
			var(--linea-suave) 5.5rem 5.56rem
		);
		transform: perspective(26rem) rotateX(73deg);
		transform-origin: bottom center;
		mask-image: linear-gradient(to top, #000, transparent 80%);
	}

	.vineta {
		background: radial-gradient(
			ellipse 85% 75% at 50% 50%,
			transparent 40%,
			var(--negro) 100%
		);
	}

	/* Candilejas: la luz entra desde el proscenio, a ras de piso */
	.candilejas {
		top: auto;
		height: 55%;
		background:
			radial-gradient(
				ellipse 60% 100% at 50% 100%,
				color-mix(in srgb, var(--hueso) 13%, transparent),
				transparent 72%
			),
			linear-gradient(
				to top,
				color-mix(in srgb, var(--rojo) 22%, transparent),
				transparent 32%
			);
		animation: alentar 9s ease-in-out infinite;
	}

	@keyframes alentar {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.85;
		}
	}

	@media (max-width: 40rem) {
		.piso {
			height: 30vh;
		}
	}
</style>
