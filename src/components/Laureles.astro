---
import laurel from '../assets/LAUREL.svg?url';

interface Props {
	tamano?: number;
}

const { tamano = 30 } = Astro.props;
const ancho = Math.round(tamano * (1691 / 1443));
---

<img
	class="laurel"
	src={laurel}
	width={ancho}
	height={tamano}
	alt=""
	aria-hidden="true"
	draggable="false"
	style={`--tamano: ${tamano}px`}
/>

<style>
	.laurel {
		display: block;
		flex: none;
		width: auto;
		height: var(--tamano);
		max-width: 100%;
		aspect-ratio: 1691 / 1443;
	}
</style>
