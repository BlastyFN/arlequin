---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FondoEscena from '../components/FondoEscena.astro';
import ArcoProscenio from '../components/ArcoProscenio.astro';
import Laureles from '../components/Laureles.astro';
import { getMarca, getPaginaSobre } from '../lib/content';

const marca = await getMarca();
const pagina = await getPaginaSobre();
const { portada, origen, objetivos, galeria } = pagina;
const giros = [-4, 3, -2, 5, -3, 2, -5, 4, -1, 3, -4, 2, -3, 5, -2];
---

<Layout
	title="Sobre nosotros — Producciones Arlequín"
	description="Conoce el origen, los objetivos y la trayectoria de Producciones Arlequín, compañía escénica de Celaya."
>
	<Header marca={marca} />

	<main id="contenido">
		<section class="hero-interior">
			<div class="escena">
				<img
					class="escena__foto"
					src={portada.foto.src}
					alt={portada.foto.alt}
					width={portada.foto.ancho}
					height={portada.foto.alto}
					loading="eager"
					fetchpriority="high"
				/>
				<div class="escena__velo" aria-hidden="true"></div>
			</div>

			<FondoEscena />
			<ArcoProscenio />

			<div class="apertura" aria-hidden="true">
				<span class="apertura__pano"></span>
				<span class="apertura__pano"></span>
			</div>

			<div class="contenedor hero-interior__cuerpo">
				<p class="rotulo rotulo--rojo">{portada.rotulo}</p>
				<h1>{portada.titular} <span>{portada.titularAcento}</span></h1>
				<p class="hero-interior__entrada">
					{portada.entrada}
				</p>
				<p class="hero-interior__credito">
					<span class="rombo" aria-hidden="true"></span>
					{portada.credito}
				</p>
			</div>
		</section>

		<section class="origen seccion" aria-labelledby="titulo-origen">
			<div class="contenedor origen__rejilla">
				<div class="origen__encabezado revelar">
					<p class="rotulo rotulo--rojo">{origen.rotulo}</p>
					<h2 id="titulo-origen">{origen.titular}</h2>
				</div>

				<div class="origen__relato revelar">
					{
						origen.parrafos.map((parrafo) => (
							<p>{parrafo}</p>
						))
					}
				</div>
			</div>

			<div class="contenedor trayectoria revelar">
				<p class="trayectoria__rotulo">{origen.trayectoriaRotulo}</p>
				<ul class="trayectoria__lista">
					{origen.trayectoria.map((item) => (
						<li>
							<Laureles tamano={42} />
							<span>{item}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="objetivos seccion" aria-labelledby="titulo-objetivos">
			<div class="objetivos__telon" aria-hidden="true"></div>
			<div class="contenedor objetivos__interior">
				<div class="objetivos__titulo revelar">
					<p class="rotulo">{objetivos.rotulo}</p>
					<h2 id="titulo-objetivos">
						{objetivos.titular.map((linea, i) => (
							<>
								{linea}
								{i < objetivos.titular.length - 1 && <br />}
							</>
						))}
						<br />
						<span>{objetivos.titularAcento}</span>
					</h2>
				</div>

				<ol class="objetivos__lista">
					{
						objetivos.lista.map(({ inicio, destacado, final }, i) => (
							<li class="objetivo revelar">
								<span class="objetivo__numero">{String(i + 1).padStart(2, '0')}</span>
								<p>
									{inicio}<strong>{destacado}</strong>{final}
								</p>
							</li>
						))
					}
				</ol>
			</div>

			<p class="contenedor objetivos__cierre revelar">
				{objetivos.cierre}
			</p>
		</section>

		<section class="galeria seccion" aria-labelledby="titulo-galeria">
			<div class="contenedor galeria__cabecera revelar">
				<div>
					<p class="rotulo rotulo--rojo">{galeria.rotulo}</p>
					<h2 id="titulo-galeria">{galeria.titular}</h2>
				</div>
			</div>

			<div class="galeria__carrusel" style={`--n: ${galeria.fotos.length}`}>
				<div class="galeria__pista">
					{
						[galeria.fotos, galeria.fotos].map((fotos, copia) => (
							<ul class="galeria__grupo" aria-hidden={copia === 1 ? 'true' : undefined}>
								{fotos.map(({ src, titulo, ancho, alto }, i) => (
									<li>
										<figure
											class="polaroid"
											style={`--giro: ${giros[i % giros.length]}deg; --rw: ${ancho}; --rh: ${alto}`}
										>
											<div class="polaroid__foto">
												<img
													src={src}
													alt={
														copia === 1
															? ''
															: `${titulo}, fotografía de la puesta en escena`
													}
													width={ancho}
													height={alto}
													loading="lazy"
												/>
											</div>
											<figcaption class="polaroid__pie">{titulo}</figcaption>
										</figure>
									</li>
								))}
							</ul>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<Footer marca={marca} />
</Layout>

<style>
	/* La fotografía es el escenario: ocupa todo el hero, el proscenio la
	   encuadra y el telón se abre sobre ella al cargar. Una sola columna de
	   texto, así nada puede solaparse con la imagen. */
	.hero-interior {
		position: relative;
		min-height: min(46rem, 90svh);
		display: grid;
		align-items: end;
		padding-top: var(--altura-barra);
		overflow: hidden;
		isolation: isolate;
	}

	.escena {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	.escena__foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 28%;
		filter: saturate(0.72) contrast(1.05) brightness(0.92);
		animation: acercar 14s var(--ease) both;
	}

	.escena__velo {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, var(--negro) 4%, rgba(5, 5, 5, 0.2) 55%, rgba(5, 5, 5, 0.55)),
			linear-gradient(to right, rgba(5, 5, 5, 0.88), rgba(5, 5, 5, 0.1) 62%);
	}

	/* Telón de apertura: dos paños que descubren la escena */
	.apertura {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		pointer-events: none;
	}

	.apertura__pano {
		flex: 1;
		background-image:
			repeating-linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.8) 0 1.1rem,
				color-mix(in srgb, var(--tinto) 92%, transparent) 1.1rem 3.2rem,
				rgba(0, 0, 0, 0.65) 3.2rem 4rem
			),
			linear-gradient(to bottom, var(--tinto), var(--negro));
	}

	.apertura__pano:first-child {
		animation: abrir-izquierda 1.6s var(--ease) 0.15s forwards;
	}

	.apertura__pano:last-child {
		animation: abrir-derecha 1.6s var(--ease) 0.15s forwards;
	}

	.hero-interior__cuerpo {
		position: relative;
		z-index: 1;
		padding-inline: calc(var(--margen) + clamp(0.85rem, 2.5vw, 3rem));
		padding-block: clamp(4rem, 12vh, 8rem) clamp(2.5rem, 7vh, 4.5rem);
	}

	.hero-interior__cuerpo .rotulo {
		animation: subir 1s var(--ease) 0.85s both;
	}

	.hero-interior h1 {
		margin-top: 1.15rem;
		font-family: var(--fuente-rotulo);
		/* El titular puede ser una frase larga: se queda en dos líneas, no en cartel. */
		font-size: clamp(2rem, 4.35vw, 5.25rem);
		font-weight: 400;
		letter-spacing: 0.02em;
		line-height: 0.92;
		text-wrap: balance;
		animation: subir 1s var(--ease) 0.95s both;
	}

	.hero-interior h1 span {
		color: var(--rojo-luz);
	}

	.hero-interior__entrada {
		max-width: min(100%, max(28rem, 50vw));
		margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
		color: var(--hueso-medio);
		font-size: clamp(1.05rem, 1.4vw, 1.25rem);
		line-height: 1.7;
		animation: subir 1s var(--ease) 1.15s both;
	}

	.hero-interior__credito {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: clamp(2rem, 5vw, 3.25rem) 0 0;
		font-family: var(--fuente-rotulo);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		color: var(--hueso-tenue);
		animation: subir 1s var(--ease) 1.3s both;
	}

	.origen {
		background:
			radial-gradient(ellipse 45% 45% at 8% 40%, rgba(63, 3, 50, 0.35), transparent 75%),
			var(--negro);
	}

	.origen__rejilla {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(3rem, 6.7vw, 8rem);
		align-items: start;
	}

	.origen__encabezado {
		position: sticky;
		top: calc(var(--altura-barra) + 2rem);
	}

	.origen h2,
	.objetivos h2,
	.galeria h2 {
		margin-top: 1.2rem;
		font-family: var(--fuente-rotulo);
		font-size: clamp(2.7rem, 5vw, 6.5rem);
		font-weight: 400;
		letter-spacing: 0.025em;
		line-height: 0.94;
	}

	.origen__relato {
		display: grid;
		gap: 1.5rem;
		color: var(--hueso-medio);
		font-size: clamp(1.08rem, 1.4vw, 1.3rem);
		line-height: 1.8;
	}

	.origen__relato p {
		margin: 0;
	}

	.origen__relato strong {
		color: var(--hueso);
		font-weight: 400;
	}

	.trayectoria {
		display: grid;
		grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1.65fr);
		gap: clamp(2rem, 5vw, 6rem);
		margin-top: clamp(5rem, 7.5vw, 9rem);
		padding-top: clamp(2rem, 4vw, 3.5rem);
		border-top: 1px solid var(--linea);
	}

	.trayectoria__rotulo {
		margin: 0;
		font-family: var(--fuente-rotulo);
		font-size: 0.72rem;
		letter-spacing: 0.22em;
		color: var(--rojo-luz);
	}

	.trayectoria__lista {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 3rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--hueso-medio);
	}

	.trayectoria__lista li {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		min-width: 0;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--linea-suave);
	}

	.objetivos {
		overflow: hidden;
		background:
			radial-gradient(ellipse 55% 75% at 0% 50%, rgba(131, 0, 24, 0.38), transparent 72%),
			linear-gradient(115deg, var(--tinto), var(--morado) 55%, var(--negro));
	}

	.objetivos__telon {
		position: absolute;
		inset: 0;
		opacity: 0.3;
		background-image: repeating-linear-gradient(
			90deg,
			transparent 0 4rem,
			rgba(243, 237, 228, 0.05) 4rem 4.05rem,
			transparent 4.05rem 8rem,
			rgba(0, 0, 0, 0.35) 8rem 9rem
		);
		mask-image: linear-gradient(to bottom, #000, transparent);
		pointer-events: none;
	}

	.objetivos__interior {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(3rem, 6.7vw, 8rem);
		align-items: start;
	}

	.objetivos h2 span {
		color: var(--rojo-luz);
	}

	.objetivos__lista {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--linea);
	}

	.objetivo {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: clamp(1rem, 2vw, 2rem);
		padding-block: clamp(1.5rem, 3vw, 2.35rem);
		border-bottom: 1px solid var(--linea);
	}

	.objetivo__numero {
		font-family: var(--fuente-rotulo);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		color: var(--rojo-luz);
	}

	.objetivo p {
		margin: 0;
		color: var(--hueso-medio);
		font-size: clamp(1.05rem, 1.35vw, 1.2rem);
		line-height: 1.7;
	}

	.objetivo strong,
	.objetivos__cierre strong {
		color: var(--hueso);
		font-weight: 400;
	}

	.objetivos__cierre {
		position: relative;
		max-width: 56rem;
		margin-top: clamp(4rem, 5.8vw, 7rem);
		margin-bottom: 0;
		color: var(--hueso-medio);
		font-size: clamp(1.4rem, 2.6vw, 2.2rem);
		line-height: 1.45;
		text-align: center;
	}

	.galeria {
		--alto-foto: clamp(10.25rem, 13.1vw, 15.75rem);
		overflow: hidden;
		background:
			radial-gradient(
				ellipse 50% 40% at 80% 20%,
				color-mix(in srgb, var(--morado) 18%, transparent),
				transparent 70%
			),
			var(--negro);
	}

	.galeria__cabecera {
		margin-bottom: clamp(2.25rem, 2.9vw, 3.5rem);
	}

	.galeria__carrusel {
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
	}

	.galeria__pista {
		display: flex;
		width: max-content;
		animation: desfilar-galeria calc(var(--n, 12) * 5.2s) linear infinite;
	}

	.galeria__carrusel:hover .galeria__pista {
		animation-play-state: paused;
	}

	.galeria__grupo {
		display: flex;
		align-items: center;
		gap: clamp(1.1rem, 2.2vw, 2rem);
		margin: 0;
		padding: 2.4rem clamp(1.1rem, 2.2vw, 2rem) 2.8rem 0;
		list-style: none;
	}

	.galeria__grupo > li {
		flex: none;
	}

	.polaroid {
		flex: none;
		margin: 0;
		display: grid;
		gap: 0.65rem;
		padding: 0.65rem 0.65rem 1rem;
		background: #efe6d8;
		color: #1a1412;
		box-shadow:
			0 1.4rem 2.8rem rgba(0, 0, 0, 0.45),
			0 0.2rem 0.5rem rgba(0, 0, 0, 0.2);
		transform: rotate(var(--giro, 0deg));
		transition: transform 0.45s var(--ease);
	}

	.polaroid:hover {
		transform: rotate(0deg) scale(1.04);
		z-index: 1;
	}

	.polaroid__foto {
		overflow: hidden;
		background: #c9b9a6;
		height: var(--alto-foto);
		width: calc(var(--alto-foto) * var(--rw, 3) / var(--rh, 2));
	}

	.polaroid__foto img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.85) contrast(1.05);
		transition:
			transform 0.7s var(--ease),
			filter 0.7s var(--ease);
	}

	.polaroid:hover .polaroid__foto img {
		transform: scale(1.04);
		filter: saturate(1) contrast(1.02);
	}

	.polaroid__pie {
		max-width: calc(var(--alto-foto) * var(--rw, 3) / var(--rh, 2));
		font-family: var(--fuente-rotulo);
		font-size: clamp(0.62rem, 0.9vw, 0.72rem);
		letter-spacing: 0.12em;
		text-align: center;
		color: #3a312c;
		line-height: 1.35;
	}

	@keyframes subir {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes acercar {
		from {
			transform: scale(1.12);
		}
		to {
			transform: scale(1);
		}
	}

	@keyframes abrir-izquierda {
		to {
			transform: translateX(-101%);
		}
	}

	@keyframes abrir-derecha {
		to {
			transform: translateX(101%);
		}
	}

	@keyframes desfilar-galeria {
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 62rem) {
		.hero-interior {
			min-height: min(40rem, 82svh);
		}

		.escena__velo {
			background:
				linear-gradient(to top, var(--negro) 12%, rgba(5, 5, 5, 0.4) 60%, rgba(5, 5, 5, 0.72)),
				linear-gradient(to right, rgba(5, 5, 5, 0.85), rgba(5, 5, 5, 0.3) 80%);
		}

		.origen__rejilla,
		.objetivos__interior {
			grid-template-columns: 1fr;
		}

		.origen__encabezado {
			position: static;
		}

		.trayectoria {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 45rem) {
		.hero-interior h1 {
			font-size: clamp(1.7rem, 7.2vw, 2.5rem);
		}

		.trayectoria__lista {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.galeria__carrusel {
			overflow-x: auto;
			mask-image: none;
		}

		.galeria__pista {
			animation: none;
		}

		.galeria__grupo[aria-hidden='true'] {
			display: none;
		}
	}
</style>
