---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Laureles from '../../components/Laureles.astro';
import { marca } from '../../data/home';
import { obras, paginaObras } from '../../data/obras';

const { portada, listado, cierre } = paginaObras;
---

<Layout
	title="Obras — Producciones Arlequín"
	description="Repertorio de Producciones Arlequín: teatro familiar, comedia y memoria histórica, disponible para giras, festivales y funciones a la medida."
>
	<Header />

	<main id="contenido">
		<section class="cartel">
			<div class="cartel__escena">
				<img
					class="cartel__foto"
					src={portada.foto.src}
					alt={portada.foto.alt}
					width={portada.foto.ancho}
					height={portada.foto.alto}
					loading="eager"
					fetchpriority="high"
				/>
				<span class="cartel__velo" aria-hidden="true"></span>
			</div>

			<span class="candilejas" aria-hidden="true"></span>

			<div class="contenedor cartel__cuerpo">
				<h1 class="cartel__titular">{portada.titular}</h1>
			</div>

			{/* El telón sube y descubre la escena; la bambalina se queda colgada */}
			<div class="telon" aria-hidden="true">
				<span class="telon__pano"></span>
			</div>

			<span class="bambalina" aria-hidden="true"></span>
		</section>

		<section class="repertorio" aria-label="Listado de obras">
			<ol class="repertorio__lista">
				{
					obras.map(({ slug, titulo, tituloCompleto, subtitulo, etiquetas, festivales, sinopsis, cartel }, i) => (
						<li class="obra revelar" id={slug}>
							<a
								class="obra__enlace"
								href={`/obras/${slug}`}
								aria-labelledby={`titulo-${slug}`}
							>
								<span class="obra__seguidor" aria-hidden="true" />

								<div class="obra__marco">
									<span class="obra__riel" />
									<span class="obra__gancho obra__gancho--izq" />
									<span class="obra__gancho obra__gancho--der" />
									<div class="obra__cartel">
										<img
											src={cartel.src}
											alt={`Cartel de ${tituloCompleto}`}
											width={cartel.ancho}
											height={cartel.alto}
											loading={i < 2 ? 'eager' : 'lazy'}
											decoding="async"
										/>
										<span class="obra__vidrio" />
									</div>
								</div>

								<div class="obra__texto">
									<h2 class="obra__titulo" id={`titulo-${slug}`}>
										{titulo}
									</h2>
									{subtitulo && <p class="obra__subtitulo">{subtitulo}</p>}

									<ul class="obra__etiquetas">
										{etiquetas.map((etiqueta) => (
											<li>{etiqueta}</li>
										))}
									</ul>

									<p class="obra__entrada">{sinopsis[0]}</p>

									{festivales.length > 0 && (
										<div class="palmares">
											<Laureles tamano={30} />
											<p class="palmares__rotulo">{listado.palmares}</p>
											<ul class="palmares__lista">
												{festivales.map((festival) => (
													<li>{festival}</li>
												))}
											</ul>
										</div>
									)}

									<span class="obra__ver">
										{listado.verFicha}
										<span class="obra__flecha" aria-hidden="true">
											&rarr;
										</span>
									</span>
								</div>
							</a>
						</li>
					))
				}
			</ol>
		</section>

		<section class="llamada" aria-labelledby="titulo-llamada">
			<div class="llamada__telon" aria-hidden="true"></div>

			<div class="contenedor llamada__cuerpo revelar">
				<p class="rotulo" id="titulo-llamada">{cierre.rotulo}</p>

				<div class="llamada__texto">
					{
						cierre.lineas.map((partes) => (
							<p>
								{partes.map(({ texto, acento }) =>
									acento ? <span class="llamada__acento">{texto}</span> : texto,
								)}
							</p>
						))
					}
				</div>

				<div class="llamada__acciones">
					<a class="boton boton--lleno" href={cierre.acciones.principal.href}>
						{cierre.acciones.principal.etiqueta}
					</a>
					<a class="boton boton--linea" href={`mailto:${marca.correo}`}>
						{marca.correo}
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	/* ---------- Banner: el telón se alza sobre la escena ---------- */

	.cartel {
		position: relative;
		min-height: min(30rem, 62svh);
		display: grid;
		align-items: center;
		padding-top: var(--altura-barra);
		overflow: hidden;
		isolation: isolate;
		background: var(--negro);
	}

	.cartel__escena {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	.cartel__foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 36% 45%;
		filter: saturate(0.88) contrast(1.06) brightness(0.86);
		animation: acercar 16s var(--ease) both;
	}

	/* La figura queda a la izquierda; el velo oscurece el costado del titular */
	.cartel__velo {
		/* Tapa: la franja de la barra queda en negro y la foto entra fundida */
		--tapa: linear-gradient(
			to bottom,
			var(--negro) 0,
			var(--negro) var(--altura-barra),
			rgba(5, 5, 5, 0.6) calc(var(--altura-barra) + 2.5rem),
			transparent calc(var(--altura-barra) + 7rem)
		);

		position: absolute;
		inset: 0;
		background:
			var(--tapa),
			linear-gradient(
				to left,
				rgba(5, 5, 5, 0.93) 0%,
				rgba(5, 5, 5, 0.62) 34%,
				rgba(5, 5, 5, 0.08) 68%
			),
			linear-gradient(to top, var(--negro) 2%, transparent 38%);
	}

	/* Candilejas: la luz sube del proscenio cuando el telón termina de abrir */
	.candilejas {
		position: absolute;
		inset: auto 0 0;
		z-index: 2;
		height: 34%;
		pointer-events: none;
		background:
			radial-gradient(
				ellipse 60% 100% at 50% 100%,
				color-mix(in srgb, var(--hueso) 14%, transparent),
				transparent 72%
			),
			linear-gradient(to top, color-mix(in srgb, var(--rojo) 26%, transparent), transparent 34%);
		opacity: 0;
		animation: encender 1.6s var(--ease) 1.55s forwards;
	}

	.cartel__cuerpo {
		position: relative;
		z-index: 3;
		display: grid;
		justify-items: end;
		text-align: right;
		padding-inline: calc(var(--margen) + clamp(0.85rem, 2.5vw, 3rem));
		padding-block: clamp(2.5rem, 7vh, 4rem);
	}

	/* line-height holgado: Headline News desborda la caja con valores menores */
	.cartel__titular {
		margin: 0;
		font-family: var(--fuente-rotulo);
		font-size: clamp(3.25rem, 12vw, 9rem);
		font-weight: 400;
		letter-spacing: 0.02em;
		line-height: 1;
		text-shadow: 0 0.15rem 2.5rem rgba(5, 5, 5, 0.9);
		animation: subir 0.9s var(--ease) 1.55s both;
	}

	/* Bambalina festoneada: el paño corto que nunca sube, encuadra la escena */
	.bambalina {
		position: absolute;
		top: var(--altura-barra);
		right: 0;
		left: 0;
		z-index: 5;
		height: clamp(1.5rem, 3.2vw, 2.4rem);
		pointer-events: none;
		background-image:
			repeating-linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.75) 0 0.9rem,
				color-mix(in srgb, var(--tinto) 94%, transparent) 0.9rem 2.6rem,
				rgba(0, 0, 0, 0.6) 2.6rem 3.4rem
			),
			linear-gradient(to bottom, color-mix(in srgb, var(--tinto) 88%, var(--negro)), var(--tinto));
	}

	.bambalina::after {
		--festo: clamp(0.7rem, 1.6vw, 1.1rem);
		content: '';
		position: absolute;
		top: 100%;
		right: 0;
		left: 0;
		height: var(--festo);
		background-image: radial-gradient(
			circle var(--festo) at 50% 0,
			var(--tinto) 0 97%,
			transparent 100%
		);
		background-size: calc(var(--festo) * 2) 100%;
		background-repeat: repeat-x;
		filter: drop-shadow(0 0.35rem 0.5rem rgba(0, 0, 0, 0.55));
	}

	.telon {
		position: absolute;
		inset: 0;
		z-index: 4;
		overflow: hidden;
		pointer-events: none;
	}

	.telon__pano {
		position: absolute;
		inset: 0;
		background-image:
			repeating-linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.82) 0 1.1rem,
				color-mix(in srgb, var(--tinto) 92%, transparent) 1.1rem 3.2rem,
				rgba(0, 0, 0, 0.66) 3.2rem 4rem
			),
			linear-gradient(to bottom, var(--tinto), color-mix(in srgb, var(--tinto) 55%, var(--negro)));
		animation: alzar 1.9s var(--ease) 0.35s forwards;
	}

	/* Galón dorado en el borde del telón: el detalle que se ve al subir */
	.telon__pano::after {
		content: '';
		position: absolute;
		inset: auto 0 0;
		height: 0.5rem;
		background: linear-gradient(to bottom, var(--dorado), var(--dorado-tenue));
		box-shadow: 0 0.5rem 1.2rem rgba(0, 0, 0, 0.6);
	}

	/* ---------- Repertorio ---------- */

	.repertorio {
		position: relative;
		padding-block: clamp(1.5rem, 4vw, 2.5rem) 0;
		background:
			radial-gradient(
				ellipse 40% 30% at 90% 0%,
				color-mix(in srgb, var(--morado) 18%, transparent),
				transparent 70%
			),
			var(--negro);
	}

	/* Las obras van a sangre: el filete que las separa cruza toda la pantalla,
	   como el pautado de un programa de mano. */
	.repertorio__lista {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.obra {
		border-top: 1px solid var(--linea);
	}

	.obra:last-child {
		border-bottom: 1px solid var(--linea);
	}

	.obra__enlace {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
		align-items: center;
		gap: clamp(1.75rem, 5vw, 4.5rem);
		padding: clamp(2.75rem, 6vw, 4.75rem) var(--margen);
		color: inherit;
		text-decoration: none;
		isolation: isolate;
	}

	.obra:nth-child(even) .obra__marco {
		order: 2;
	}

	.obra:nth-child(even) .obra__texto {
		order: 1;
	}

	/* El seguidor se enciende sobre la obra apuntada */
	.obra__seguidor {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(
			ellipse 55% 130% at 50% 45%,
			color-mix(in srgb, var(--morado) 42%, transparent),
			transparent 72%
		);
		opacity: 0;
		transition: opacity 0.55s var(--ease);
	}

	.obra__enlace:hover .obra__seguidor,
	.obra__enlace:focus-visible .obra__seguidor {
		opacity: 1;
	}

	/* Cartel colgado de un riel, como en el vestíbulo */
	.obra__marco {
		position: relative;
		padding-top: 1.35rem;
		transform: rotate(-1.4deg);
		transform-origin: top center;
		transition: transform 0.55s var(--ease);
	}

	.obra:nth-child(even) .obra__marco {
		transform: rotate(1.4deg);
	}

	.obra__enlace:hover .obra__marco,
	.obra__enlace:focus-visible .obra__marco,
	.obra:nth-child(even) .obra__enlace:hover .obra__marco,
	.obra:nth-child(even) .obra__enlace:focus-visible .obra__marco {
		transform: rotate(0deg);
	}

	.obra__riel {
		position: absolute;
		top: 0.35rem;
		right: 8%;
		left: 8%;
		height: 1px;
		background: var(--linea);
	}

	.obra__gancho {
		position: absolute;
		top: 0.12rem;
		width: 0.55rem;
		height: 0.9rem;
		border: 1px solid color-mix(in srgb, var(--hueso) 35%, transparent);
		border-bottom: 0;
		border-radius: 0.35rem 0.35rem 0 0;
	}

	.obra__gancho--izq {
		left: 18%;
	}

	.obra__gancho--der {
		right: 18%;
	}

	.obra__cartel {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: var(--negro-carta);
		border: 1px solid var(--linea);
		box-shadow:
			0 1.4rem 2.8rem rgba(0, 0, 0, 0.55),
			0 0.2rem 0.5rem rgba(0, 0, 0, 0.25);
		transition: border-color 0.4s var(--ease);
	}

	.obra__cartel img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.65) brightness(0.82);
		transition:
			transform 0.8s var(--ease),
			filter 0.6s var(--ease);
	}

	/* Reflejo de vitrina: el cristal del vestíbulo */
	.obra__vidrio {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			115deg,
			color-mix(in srgb, var(--hueso) 16%, transparent) 0%,
			transparent 28%,
			transparent 62%,
			color-mix(in srgb, var(--hueso) 6%, transparent) 100%
		);
		pointer-events: none;
		opacity: 0.55;
		transition: opacity 0.45s var(--ease);
	}

	.obra__enlace:hover .obra__cartel,
	.obra__enlace:focus-visible .obra__cartel {
		border-color: color-mix(in srgb, var(--hueso) 32%, transparent);
	}

	.obra__enlace:hover .obra__cartel img,
	.obra__enlace:focus-visible .obra__cartel img {
		transform: scale(1.04);
		filter: saturate(1) brightness(1);
	}

	.obra__enlace:hover .obra__vidrio,
	.obra__enlace:focus-visible .obra__vidrio {
		opacity: 0.2;
	}

	.obra__texto {
		display: grid;
		justify-items: start;
		gap: 0.9rem;
	}

	.obra__titulo {
		max-width: 18ch;
		margin: 0;
		font-family: var(--fuente-rotulo);
		font-size: clamp(1.65rem, 2.6vw + 0.4rem, 3.1rem);
		font-weight: 400;
		letter-spacing: 0.025em;
		line-height: 0.98;
		text-wrap: balance;
	}

	.obra__subtitulo {
		margin: -0.25rem 0 0;
		font-family: var(--fuente-rotulo);
		font-size: clamp(0.72rem, 0.9vw, 0.85rem);
		letter-spacing: 0.2em;
		color: var(--hueso-medio);
	}

	.obra__etiquetas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0.2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.obra__etiquetas li {
		padding: 0.38rem 0.75rem;
		border: 1px solid var(--linea);
		font-family: var(--fuente-rotulo);
		font-size: 0.62rem;
		letter-spacing: 0.18em;
		color: var(--hueso-tenue);
	}

	.obra__entrada {
		max-width: 46ch;
		margin: 0.35rem 0 0;
		color: var(--hueso-medio);
		font-size: clamp(1rem, 1.2vw, 1.1rem);
		line-height: 1.75;
	}

	/* Palmarés: la corona rotula la lista, que se queda en voz baja */
	.palmares {
		display: grid;
		justify-items: start;
		gap: 0.4rem;
		width: 100%;
		max-width: 34rem;
		margin-top: 0.6rem;
		padding-top: 1.1rem;
		border-top: 1px solid var(--linea-suave);
	}

	.palmares__rotulo {
		margin: 0.1rem 0 0;
		font-family: var(--fuente-rotulo);
		font-size: 0.62rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--dorado);
	}

	.palmares__lista {
		list-style: none;
		display: grid;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--hueso-tenue);
	}

	.obra__ver {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		margin-top: 0.6rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid transparent;
		font-family: var(--fuente-rotulo);
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		color: var(--hueso);
		transition: border-color 0.35s var(--ease);
	}

	.obra__flecha {
		color: var(--rojo-luz);
		transition: transform 0.35s var(--ease);
	}

	.obra__enlace:hover .obra__ver,
	.obra__enlace:focus-visible .obra__ver {
		border-bottom-color: var(--rojo-luz);
	}

	.obra__enlace:hover .obra__flecha,
	.obra__enlace:focus-visible .obra__flecha {
		transform: translateX(0.4rem);
	}

	.obra__enlace:focus-visible {
		outline: 2px solid var(--rojo-luz);
		outline-offset: -0.5rem;
	}

	/* ---------- Cierre ---------- */

	.llamada {
		position: relative;
		overflow: hidden;
		padding-block: clamp(4.5rem, 10vw, 8rem);
		background:
			radial-gradient(
				ellipse 70% 90% at 20% 50%,
				color-mix(in srgb, var(--tinto) 85%, transparent),
				transparent 68%
			),
			radial-gradient(
				ellipse 60% 80% at 85% 35%,
				color-mix(in srgb, var(--morado) 65%, transparent),
				transparent 66%
			),
			var(--negro);
	}

	.llamada__telon {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image: repeating-linear-gradient(
			90deg,
			transparent 0 3.4rem,
			rgba(243, 237, 228, 0.032) 3.4rem 3.46rem,
			transparent 3.46rem 6.8rem,
			rgba(0, 0, 0, 0.3) 6.8rem 7.5rem
		);
		mask-image: linear-gradient(to bottom, #000, transparent 88%);
	}

	.llamada__cuerpo {
		position: relative;
		display: grid;
		justify-items: center;
		gap: clamp(1.5rem, 3vw, 2.25rem);
		text-align: center;
	}

	.llamada__texto {
		display: grid;
		gap: 1rem;
		max-width: 40rem;
		font-family: var(--fuente-rotulo);
		font-size: clamp(1.1rem, 1.6vw + 0.45rem, 1.85rem);
		letter-spacing: 0.05em;
		line-height: 1.45;
	}

	.llamada__texto p {
		margin: 0;
	}

	.llamada__acento {
		color: var(--rojo-luz);
	}

	.llamada__acciones {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.9rem;
		margin-top: 0.75rem;
	}

	.boton {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--fuente-rotulo);
		font-size: 0.85rem;
		letter-spacing: 0.2em;
		text-indent: 0.2em;
		text-decoration: none;
		padding: 1.05rem 2.1rem;
		border: 1px solid transparent;
		transition:
			background 0.35s var(--ease),
			border-color 0.35s var(--ease),
			color 0.35s var(--ease);
	}

	.boton--lleno {
		background: var(--rojo);
		color: var(--hueso);
	}

	.boton--lleno:hover {
		background: var(--rojo-luz);
	}

	.boton--linea {
		border-color: var(--linea);
		color: var(--hueso-medio);
		letter-spacing: 0.1em;
		font-family: var(--fuente-cuerpo);
		text-indent: 0;
		font-size: 0.95rem;
	}

	.boton--linea:hover {
		border-color: var(--hueso);
		color: var(--hueso);
	}

	/* ---------- Animaciones ---------- */

	@keyframes subir {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes acercar {
		from {
			transform: scale(1.1);
		}
		to {
			transform: scale(1);
		}
	}

	@keyframes alzar {
		to {
			transform: translateY(-101%);
		}
	}

	@keyframes encender {
		to {
			opacity: 1;
		}
	}

	/* ---------- Adaptaciones ---------- */

	@media (max-width: 62rem) {
		.cartel {
			min-height: min(26rem, 58svh);
		}

		/* En vertical la figura ocupa el cuadro: el velo pasa a ser de abajo */
		.cartel__velo {
			background:
				var(--tapa),
				linear-gradient(to top, var(--negro) 8%, rgba(5, 5, 5, 0.45) 52%, rgba(5, 5, 5, 0.6)),
