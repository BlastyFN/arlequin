---
import Layout from '../layouts/Layout.astro';
import BarraClasica from '../components/propuesta2/BarraClasica.astro';
import HeroTelon from '../components/propuesta2/HeroTelon.astro';
import { heroeClasico } from '../data/propuesta2';
import { getMarca } from '../lib/content';

const marca = await getMarca();
---

<Layout
	title={`${marca.nombre} — Propuesta 2`}
	description={heroeClasico.entrada}
>
	<BarraClasica />
	<main id="contenido">
		<HeroTelon />
	</main>
</Layout>
