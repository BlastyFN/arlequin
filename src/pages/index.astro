---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Cintillo from '../components/Cintillo.astro';
import SobreNosotros from '../components/SobreNosotros.astro';
import Obras from '../components/Obras.astro';
import Prensa from '../components/Prensa.astro';
import Respaldos from '../components/Respaldos.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { getContacto, getHome, getMarca } from '../lib/content';

const marca = await getMarca();
const home = await getHome();
const contacto = await getContacto();
---

<Layout
	title={`${marca.nombre} — Compañía y productora de teatro`}
	description={home.heroe.entrada}
>
	<Header marca={marca} />
	<main id="contenido">
		<Hero heroe={home.heroe} />
		<Cintillo cintillo={home.cintillo} />
		<SobreNosotros sobreNosotros={home.sobreNosotros} />
		<Respaldos respaldos={home.respaldos} />
		<Obras obrasInicio={home.obrasInicio} />
		<Prensa prensa={home.prensa} />
		<Contacto contacto={contacto} />
	</main>
	<Footer marca={marca} />
</Layout>
