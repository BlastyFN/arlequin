---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FondoEscena from '../components/FondoEscena.astro';
import ArcoProscenio from '../components/ArcoProscenio.astro';
import { marca } from '../data/home';
import { paginaServicios } from '../data/servicios';

const { portada, oficios, pastorela, cierre } = paginaServicios;
---

<Layout
	title="Servicios — Producciones Arlequín"
	description="Capacitaciones, formaciones, profesionalización artística y pastorelas corporativas personalizadas. El oficio de la escena, a la medida de equipos, artistas y empresas."
>
	<Header />

	<main id="contenido">
		<section class="hero-interior">
			<div class="escena">
				<img
					class="escena__foto"
					src={portada.foto.src}
					alt={portada.foto.alt}
					width={portada.foto.ancho}
					height={portada.foto.alto}
					loading="eager"
					fetchpriority="high"
				/>
				<div class="escena__velo" aria-hidden="true"></div>
			</div>

			<FondoEscena />
			<ArcoProscenio />

			<div class="apertura" aria-hidden="true">
				<span class="apertura__pano"></span>
				<span class="apertura__pano"></span>
			</div>

			<div class="contenedor hero-interior__cuerpo">
				<p class="rotulo rotulo--rojo">{portada.rotulo}</p>
				<h1>{portada.titular}</h1>
				<p class="hero-interior__entrada">{portada.entrada}</p>
				<p class="hero-interior__credito">
					<span class="rombo" aria-hidden="true"></span>
					{portada.credito}
				</p>
			</div>
		</section>

		<section class="oficios seccion" aria-labelledby="titulo-oficios">
			<div class="oficios__telon" aria-hidden="true"></div>
			<div class="contenedor oficios__interior">
				<div class="oficios__titulo revelar">
					<p class="rotulo">{oficios.rotulo}</p>
					<h2 id="titulo-oficios">
						{oficios.titular.lineas[0]}<br />
						{oficios.titular.lineas[1]}<br />
						<span>{oficios.titular.remate}</span>
					</h2>
				</div>

				<ol class="oficios__lista">
					{
						oficios.lista.map(({ titulo, texto }, i) => (
							<li class="oficio revelar" style={`transition-delay:${i * 80}ms`}>
								<span class="oficio__numero">{String(i + 1).padStart(2, '0')}</span>
								<div class="oficio__cuerpo">
									<h3 class="oficio__titulo">{titulo}</h3>
									<p>{texto}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="pastorela seccion" aria-labelledby="titulo-pastorela">
			<div class="pastorela__cielo" aria-hidden="true"></div>
			<span class="pastorela__candilejas" aria-hidden="true"></span>

			<div class="contenedor pastorela__escena">
				<figure class="pastorela__vitrina revelar">
					<span class="pastorela__belen" aria-hidden="true">
						<span class="pastorela__belen-halo"></span>
						<span class="pastorela__belen-rayos"></span>
						<span class="pastorela__belen-cuerpo"></span>
					</span>
					<span class="pastorela__riel" aria-hidden="true"></span>
					<span class="pastorela__gancho pastorela__gancho--izq" aria-hidden="true"></span>
					<span class="pastorela__gancho pastorela__gancho--der" aria-hidden="true"></span>

					<div class="pastorela__marco">
						<div class="pastorela__reserva" aria-hidden="true">
							<span class="pastorela__estrella"></span>
							<p>{pastorela.foto.pie}</p>
						</div>
						<img
							src={pastorela.foto.src}
							alt={pastorela.foto.alt}
							width={pastorela.foto.ancho}
							height={pastorela.foto.alto}
							loading="lazy"
							decoding="async"
							onerror="this.hidden = true"
						/>
						<span class="pastorela__vidrio" aria-hidden="true"></span>
						<span class="pastorela__haz" aria-hidden="true"></span>
					</div>

					<figcaption class="pastorela__pie">
						<span class="rombo" aria-hidden="true"></span>
						{pastorela.rotulo}
					</figcaption>
				</figure>

				<div class="pastorela__texto revelar">
					<p class="rotulo pastorela__rotulo">{pastorela.rotulo}</p>
					<h2 id="titulo-pastorela">
						{pastorela.titulo}
						<span>{pastorela.subtitulo}</span>
					</h2>
					<p class="pastorela__entrada">{pastorela.entrada}</p>
					<div class="pastorela__relato">
						{pastorela.parrafos.map((parrafo) => <p>{parrafo}</p>)}
					</div>
					<a class="boton boton--lleno" href={pastorela.cta.href}>
						{pastorela.cta.etiqueta}
					</a>
				</div>
			</div>
		</section>

		<section class="llamada" aria-labelledby="titulo-llamada">
			<div class="llamada__telon" aria-hidden="true"></div>

			<div class="contenedor llamada__cuerpo revelar">
				<p class="rotulo" id="titulo-llamada">{cierre.rotulo}</p>

				<div class="llamada__texto">
					{
						cierre.lineas.map((partes) => (
							<p>
								{partes.map(({ texto, acento }) =>
									acento ? <span class="llamada__acento">{texto}</span> : texto,
								)}
							</p>
						))
					}
				</div>

				<div class="llamada__acciones">
					<a class="boton boton--lleno" href={cierre.acciones.principal.href}>
						{cierre.acciones.principal.etiqueta}
					</a>
					<a class="boton boton--linea" href={`mailto:${marca.correo}`}>
						{marca.correo}
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.hero-interior {
		position: relative;
		min-height: min(46rem, 90svh);
		display: grid;
		align-items: end;
		padding-top: var(--altura-barra);
		overflow: hidden;
		isolation: isolate;
	}

	.escena {
		position: absolute;
		inset: 0;
		z-index: -2;
	}

	.escena__foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
		filter: saturate(0.72) contrast(1.05) brightness(0.92);
		animation: acercar 14s var(--ease) both;
	}

	.escena__velo {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to top, var(--negro) 4%, rgba(5, 5, 5, 0.2) 55%, rgba(5, 5, 5, 0.55)),
			linear-gradient(to right, rgba(5, 5, 5, 0.88), rgba(5, 5, 5, 0.1) 62%);
	}

	.apertura {
		position: absolute;
		inset: 0;
		z-index: 3;
		display: flex;
		pointer-events: none;
	}

	.apertura__pano {
		flex: 1;
		background-image:
			repeating-linear-gradient(
				90deg,
				rgba(0, 0, 0, 0.8) 0 1.1rem,
				color-mix(in srgb, var(--tinto) 92%, transparent) 1.1rem 3.2rem,
				rgba(0, 0, 0, 0.65) 3.2rem 4rem
			),
			linear-gradient(to bottom, var(--tinto), var(--negro));
	}

	.apertura__pano:first-child {
		animation: abrir-izquierda 1.6s var(--ease) 0.15s forwards;
	}

	.apertura__pano:last-child {
		animation: abrir-derecha 1.6s var(--ease) 0.15s forwards;
	}

	.hero-interior__cuerpo {
		position: relative;
		z-index: 1;
		padding-inline: calc(var(--margen) + clamp(0.85rem, 2.5vw, 3rem));
		padding-block: clamp(4rem, 12vh, 8rem) clamp(2.5rem, 7vh, 4.5rem);
	}

	.hero-interior__cuerpo .rotulo {
		animation: subir 1s var(--ease) 0.85s both;
	}

	.hero-interior h1 {
		margin-top: 1.15rem;
		font-family: var(--fuente-rotulo);
		font-size: clamp(2.75rem, 12vw, 9.25rem);
		font-weight: 400;
		letter-spacing: 0.02em;
		line-height: 0.92;
		text-wrap: balance;
		animation: subir 1s var(--ease) 0.95s both;
	}

	.hero-interior__entrada {
		max-width: 42ch;
		margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
		color: var(--hueso-medio);
		font-size: clamp(1.05rem, 1.4vw, 1.25rem);
		line-height: 1.7;
		animation: subir 1s var(--ease) 1.15s both;
	}

	.hero-interior__credito {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: clamp(2rem, 5vw, 3.25rem) 0 0;
		font-family: var(--fuente-rotulo);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		color: var(--hueso-tenue);
		animation: subir 1s var(--ease) 1.3s both;
	}

	/* ---------- Oficios ---------- */

	.oficios {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(ellipse 55% 75% at 0% 50%, rgba(131, 0, 24, 0.38), transparent 72%),
			linear-gradient(115deg, var(--tinto), var(--morado) 55%, var(--negro));
	}

	.oficios__telon {
		position: absolute;
		inset: 0;
		opacity: 0.3;
		background-image: repeating-linear-gradient(
			90deg,
			transparent 0 4rem,
			rgba(243, 237, 228, 0.05) 4rem 4.05rem,
			transparent 4.05rem 8rem,
			rgba(0, 0, 0, 0.35) 8rem 9rem
		);
		mask-image: linear-gradient(to bottom, #000, transparent);
		pointer-events: none;
	}

	.oficios__interior {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(3rem, 8vw, 8rem);
		align-items: start;
	}

	.oficios__titulo {
		min-width: 0;
		container-type: inline-size;
	}

	.oficios h2 {
		margin-top: 1.2rem;
		font-family: var(--fuente-rotulo);
		/* Cabe PROFESIONALIZAR. entero en la columna, sin partir la última letra */
		font-size: clamp(1.5rem, 7.6cqi, 3.4rem);
		font-weight: 400;
		letter-spacing: 0.02em;
		line-height: 0.94;
	}

	.oficios h2 span {
		display: block;
		color: var(--rojo-luz);
		white-space: nowrap;
	}

	.oficios__lista {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--linea);
	}

	.oficio {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: clamp(1rem, 2vw, 2rem);
		padding-block: clamp(1.5rem, 3vw, 2.35rem);
		border-bottom: 1px solid var(--linea);
	}

	.oficio__numero {
		font-family: var(--fuente-rotulo);
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		color: var(--rojo-luz);
	}

	.oficio__titulo {
		margin: 0 0 0.55rem;
		font-family: var(--fuente-rotulo);
		font-size: clamp(1.05rem, 1.5vw, 1.35rem);
		font-weight: 400;
		letter-spacing: 0.08em;
		line-height: 1.15;
	}

	.oficio p {
		margin: 0;
		color: var(--hueso-medio);
		font-size: clamp(1.05rem, 1.35vw, 1.2rem);
		line-height: 1.7;
	}

	/* ---------- Pastorela: temporada navideña ---------- */

	.pastorela {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background:
			radial-gradient(
				ellipse 55% 70% at 18% 8%,
				color-mix(in srgb, var(--dorado) 22%, transparent),
				transparent 58%
			),
			radial-gradient(
				ellipse 50% 55% at 92% 88%,
				color-mix(in srgb, var(--rojo) 26%, transparent),
				transparent 62%
			),
			radial-gradient(
				ellipse 70% 80% at 50% 50%,
				#1a3d2a,
				transparent 72%
			),
			linear-gradient(165deg, #163326 0%, #0e2218 48%, #07110c 100%);
	}

	.pastorela__cielo {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background-image:
			radial-gradient(1.5px 1.5px at 12% 18%, color-mix(in srgb, var(--hueso) 55%, transparent), transparent),
			radial-gradient(1.5px 1.5px at 28% 8%, color-mix(in srgb, var(--dorado) 70%, transparent), transparent),
			radial-gradient(1px 1px at 47% 22%, color-mix(in srgb, var(--hueso) 40%, transparent), transparent),
			radial-gradient(1.5px 1.5px at 63% 12%, color-mix(in srgb, var(--hueso) 50%, transparent), transparent),
			radial-gradient(1px 1px at 81% 20%, color-mix(in srgb, var(--dorado) 55%, transparent), transparent),
			radial-gradient(1.5px 1.5px at 91% 7%, color-mix(in srgb, var(--hueso) 45%, transparent), transparent);
		mask-image: linear-gradient(to bottom, #000 0%, transparent 55%);
		opacity: 0.7;
	}

	.pastorela__candilejas {
		position: absolute;
		inset: auto 0 0;
		z-index: 0;
		height: 32%;
		pointer-events: none;
		background:
			radial-gradient(
				ellipse 70% 100% at 50% 100%,
				color-mix(in srgb, var(--dorado) 20%, transparent),
				transparent 72%
			),
			linear-gradient(
				to top,
				color-mix(in srgb, #1a3d2a 55%, transparent),
				transparent 42%
			);
	}

	.pastorela__escena {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
		gap: clamp(2.5rem, 6vw, 6.5rem);
		align-items: center;
	}

	.pastorela__vitrina {
		position: relative;
		margin: 0;
		justify-self: center;
		width: min(100%, 26rem);
		padding-top: 2.15rem;
	}

	.pastorela__belen {
		position: absolute;
		top: 0.05rem;
		left: 50%;
		z-index: 4;
		display: grid;
		place-items: center;
		width: 2.35rem;
		height: 2.35rem;
		translate: -50% 0;
		pointer-events: none;
	}

	.pastorela__belen-halo {
		position: absolute;
		inset: -0.85rem;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--dorado) 55%, transparent),
			transparent 68%
		);
		animation: titilar 3.4s ease-in-out infinite;
	}

	.pastorela__belen-rayos,
	.pastorela__belen-cuerpo {
		grid-area: 1 / 1;
		background: var(--dorado);
		filter: drop-shadow(0 0 0.55rem color-mix(in srgb, var(--dorado) 75%, transparent));
	}

	.pastorela__belen-rayos {
		width: 2.15rem;
		height: 2.15rem;
		clip-path: polygon(
			50% 0%,
			54% 46%,
			100% 50%,
			54% 54%,
			50% 100%,
			46% 54%,
			0% 50%,
			46% 46%
		);
	}

	.pastorela__belen-cuerpo {
		width: 1.05rem;
		height: 1.05rem;
		background: color-mix(in srgb, var(--dorado) 70%, var(--hueso));
		clip-path: polygon(
			50% 0%,
			61% 35%,
			100% 50%,
			61% 65%,
			50% 100%,
			39% 65%,
			0% 50%,
			39% 35%
		);
		animation: titilar 3.4s ease-in-out 0.4s infinite;
	}

	.pastorela__riel {
		position: absolute;
		top: 1.15rem;
		right: 8%;
		left: 8%;
		height: 1px;
		background: color-mix(in srgb, var(--dorado) 55%, transparent);
	}

	.pastorela__gancho {
		position: absolute;
		top: 0.92rem;
		width: 0.55rem;
		height: 0.9rem;
		border: 1px solid color-mix(in srgb, var(--dorado) 55%, transparent);
		border-bottom: 0;
		border-radius: 0.35rem 0.35rem 0 0;
	}

	.pastorela__gancho--izq {
		left: 18%;
	}

	.pastorela__gancho--der {
		right: 18%;
	}

	.pastorela__marco {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 5;
		margin-top: 0.15rem;
		background: #14080b;
		border: 1px solid color-mix(in srgb, var(--dorado) 45%, transparent);
		box-shadow:
			0 0 0 0.45rem color-mix(in srgb, var(--tinto) 80%, #000),
			0 1.6rem 3rem rgba(0, 0, 0, 0.55),
			0 0 2.5rem color-mix(in srgb, var(--dorado) 18%, transparent);
		transform: rotate(-1.2deg);
		transform-origin: top center;
	}

	.pastorela__reserva {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 1.25rem;
		background:
			radial-gradient(
				ellipse 55% 40% at 50% 18%,
				color-mix(in srgb, var(--dorado) 28%, transparent),
				transparent 62%
			),
			radial-gradient(ellipse 80% 50% at 50% 100%, color-mix(in srgb, var(--rojo) 22%, transparent), transparent),
			#14080b;
		color: var(--dorado);
		font-family: var(--fuente-rotulo);
		font-size: 0.72rem;
		letter-spacing: 0.22em;
	}

	.pastorela__reserva p {
		margin: 0;
	}

	.pastorela__estrella {
		width: 1.15rem;
		height: 1.15rem;
		background: var(--dorado);
		clip-path: polygon(
			50% 0%,
			61% 35%,
			100% 50%,
			61% 65%,
			50% 100%,
			39% 65%,
			0% 50%,
			39% 35%
		);
		filter: drop-shadow(0 0 0.6rem color-mix(in srgb, var(--dorado) 70%, transparent));
	}

	.pastorela__marco img {
		position: absolute;
		inset: 0;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.88) contrast(1.04) brightness(0.92);
	}

	.pastorela__marco img[hidden] {
		display: none;
	}

	.pastorela__vidrio {
		position: absolute;
		inset: 0;
		z-index: 2;
		pointer-events: none;
		background: linear-gradient(
			115deg,
			color-mix(in srgb, var(--hueso) 18%, transparent) 0%,
			transparent 26%,
			transparent 64%,
			color-mix(in srgb, var(--dorado) 8%, transparent) 100%
		);
	}

	.pastorela__haz {
		position: absolute;
		inset: 0 8% auto;
		z-index: 2;
		height: 42%;
		pointer-events: none;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--dorado) 22%, transparent),
			transparent
		);
		mask-image: linear-gradient(to right, transparent, #000 20%, #000 80%, transparent);
	}

	.pastorela__pie {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1.15rem;
		font-family: var(--fuente-rotulo);
		font-size: 0.68rem;
		letter-spacing: 0.2em;
		color: var(--dorado);
	}

	.pastorela__pie .rombo {
		background: var(--dorado);
	}

	.pastorela__texto {
		min-width: 0;
		container-type: inline-size;
		display: grid;
		justify-items: start;
		gap: 0;
	}

	.pastorela__rotulo {
		color: var(--dorado);
	}

	.pastorela h2 {
		margin-top: 1.1rem;
		font-family: var(--fuente-rotulo);
		font-size: clamp(1.6rem, 9cqi, 4.25rem);
		font-weight: 400;
		letter-spacing: 0.02em;
		line-height: 0.92;
	}

	.pastorela h2 span {
		display: block;
		color: var(--rojo-luz);
		white-space: nowrap;
	}

	.pastorela__entrada {
		margin: clamp(1.1rem, 2.2vw, 1.6rem) 0 0;
		font-family: var(--fuente-titular);
		font-size: clamp(1.45rem, 2.2vw, 2rem);
		font-style: italic;
		line-height: 1.3;
		color: var(--hueso);
	}

	.pastorela__relato {
		display: grid;
		gap: 1.2rem;
		margin-top: clamp(1.35rem, 2.5vw, 1.85rem);
		color: var(--hueso-medio);
		font-size: clamp(1.08rem, 1.4vw, 1.3rem);
		line-height: 1.8;
	}

	.pastorela__relato p {
		margin: 0;
	}

	.pastorela__texto .boton {
		margin-top: clamp(1.5rem, 3vw, 2.1rem);
	}

	/* ---------- Cierre ---------- */

	.llamada {
		position: relative;
		overflow: hidden;
		padding-block: clamp(4.5rem, 10vw, 8rem);
		background:
			radial-gradient(
				ellipse 70% 90% at 20% 50%,
				color-mix(in srgb, var(--tinto) 85%, transparent),
				transparent 68%
			),
			radial-gradient(
				ellipse 60% 80% at 85% 35%,
				color-mix(in srgb, var(--morado) 65%, transparent),
				transparent 66%
			),
			var(--negro);
	}

	.llamada__telon {
		position: absolute;
